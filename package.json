{
  "name": "minecraft-mcp",
  "version": "1.0.0",
  "description": "MCP server that lets AI agents read and manage a Minecraft server through WorldAPI",
  "type": "module",
  "private": true,
  "bin": {
    "minecraft-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "openapi"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "generate": "node scripts/generate.mjs",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "openapi-fetch": "^0.17.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
