{
  "name": "@mairwunnx/minecraft-mcp",
  "version": "0.0.0-dev",
  "mcpName": "com.mairwunnx/minecraft-mcp",
  "description": "MCP server that lets AI agents read and manage a Minecraft server through WorldAPI",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "minecraft",
    "minecraft-server",
    "paper",
    "papermc",
    "worldapi",
    "ai-agent",
    "claude"
  ],
  "homepage": "https://github.com/MairwunNx/minecraft-mcp#readme",
  "bugs": {
    "url": "https://github.com/MairwunNx/minecraft-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MairwunNx/minecraft-mcp.git"
  },
  "license": "MIT",
  "author": "Pavel Erokhin (MairwunNx)",
  "type": "module",
  "bin": {
    "minecraft-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "openapi"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "generate": "node scripts/generate.mjs",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "pack:mcpb": "node scripts/pack-mcpb.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "openapi-fetch": "^0.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
